@startuml
' Layout settings for better fit
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam wrapWidth 200

' Namespace declaration
package "FlowForge" {

    ' Classes with reduced details and improved layout
    class FlowEdge {
        + MaxFlow : double
        + CurrentFlow : double
        + Residual : double
        + FlowEdge(source, target, maxFlow)
    }

    class FlowNode

    FlowEdge --> FlowNode : "Source, Target"

    class FlowGraph {
        + Graph : BidirectionalGraph<FlowNode, FlowEdge>
        + AddVertex(id, label)
        + AddEdge(sourceId, targetId, maxFlow)
        + ResetFlow()
        + Clone()
    }
    FlowGraph --> FlowEdge : "Edges"

    class GraphVisualizer {
        + ConvertToMsaglGraph(flowGraph) : Graph
    }
    GraphVisualizer ..> FlowGraph : "Uses"

    class MainWindow {
        - _gViewer : GViewer
        - _flowGraph : FlowGraph
        - _fordFulkerson : FordFulkersonAlgorithm
        + MainWindow()
        + SetupGraphViewer()
        + InitializeGraphButton_Click()
        + FordFulkersonButton_Click()
        + DisplayGraph()
        + ExportToLatexButton_Click()
    }
    MainWindow ..> FlowGraph : "Uses"
    MainWindow ..> GraphVisualizer : "Uses"

    class TikzCodeGenerator {
        - _flowGraph : FlowGraph
        - _fordFulkerson : FordFulkersonAlgorithm
        + TikzCodeGenerator(flowGraph, nodePositions, fordFulkerson)
        + ExportGraphToLatex(includeAnimation, standalone)
    }
    TikzCodeGenerator ..> FordFulkersonAlgorithm : "Uses"

    class FordFulkersonAlgorithm {
        + SourceId : string
        + TargetId : string
        - _flowGraph : FlowGraph
        + Run(strategy) : double
        + FindAugmentingPathBfs() : bool
        + FindAugmentingPathDfs() : bool
    }
    FordFulkersonAlgorithm ..> FlowGraph : "Uses"
}
@enduml